# LLM 模型配置 (OpenAI 兼容格式)
# 复制为 agent-server/.env 并填入真实 key。该 .env 已被 .gitignore 忽略, 不会提交。
# 默认指向智谱 GLM-5.2; 也可改成任意 OpenAI 兼容端点 (DeepSeek / OpenAI / Moonshot 等)。

# 必填: LLM API Key (默认智谱 https://open.bigmodel.cn/)
LLM_API_KEY=your-llm-key

# 可选: 默认 https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选: 默认 glm-5.2
LLM_MODEL=glm-5.2
